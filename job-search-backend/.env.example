# Copy this file to .env and fill in real values. .env is gitignored.
#
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Subscribe (free tier: 200 requests/month) and copy your X-RapidAPI-Key.
RAPIDAPI_KEY=

# Google Gemini — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model id (defaults to gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: JSearch country filter (defaults to au).
# JSEARCH_COUNTRY=us
